{
  "name": "Cove Downloader Helper",
  "description": "Send page and link URLs to Cove downloaders (yt-dlp, text, audio, Reddit) with match picking and a live job queue.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["contextMenus", "storage", "tabs", "windows"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Download current page with Cove",
    "default_icon": {
      "16": "cove-icon-16.png",
      "32": "cove-icon-32.png",
      "48": "cove-icon-48.png",
      "128": "cove-icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "cove-icon-16.png",
    "32": "cove-icon-32.png",
    "48": "cove-icon-48.png",
    "128": "cove-icon-128.png",
    "256": "cove-icon-256.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["cove-icon-32.png", "cove-icon-48.png", "icon.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
