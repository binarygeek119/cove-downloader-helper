{
  "name": "Cove Downloader Helper",
  "description": "Send page and link URLs to your self-hosted Cove app to download with yt-dlp and other Cove downloaders.",
  "version": "1.0.1",
  "manifest_version": 3,
  "homepage_url": "https://github.com/binarygeek119/cove-downloader-helper",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["contextMenus", "storage", "tabs", "scripting", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Download current page with Cove",
    "default_icon": {
      "16": "cove-icon-16.png",
      "32": "cove-icon-32.png",
      "48": "cove-icon-48.png",
      "128": "cove-icon-128.png"
    }
  },
  "icons": {
    "16": "cove-icon-16.png",
    "32": "cove-icon-32.png",
    "48": "cove-icon-48.png",
    "128": "cove-icon-128.png",
    "256": "cove-icon-256.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["cove-icon-32.png", "cove-icon-48.png", "icon.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
