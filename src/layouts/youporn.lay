{
  "version": 1,
  "hosts": ["youporn.com"],
  "targets": [
    {
      "id": "watch",
      "kind": "video",
      "path": "/watch",
      "anchor": { "selector": "#videoFlagPopButton", "insert": "afterend" },
      "button": {
        "size": "small",
        "showText": false,
        "label": "Download",
        "shape": "square",
        "colors": {
          "background": "#1c1c1d",
          "text": "#bbbbbb",
          "icon": "#bbbbbb",
          "border": "#1c1c1d",
          "hoverBackground": "#1c1c1d"
        }
      }
    }
  ]
}
