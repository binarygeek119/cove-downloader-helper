{
  "version": 1,
  "hosts": ["pornhub.com"],
  "targets": [
    {
      "id": "video",
      "kind": "video",
      "path": "/view_video.php",
      "anchor": { "selector": ".userActions .js_videoSubscribeButton", "insert": "afterend" },
      "button": {
        "size": "medium",
        "showText": true,
        "label": "Download",
        "shape": "pill",
        "colors": {
          "background": "#ff9000",
          "text": "#ffffff",
          "icon": "#ffffff",
          "border": "#ff9000",
          "hoverBackground": "#ffa31a"
        }
      }
    },
    {
      "id": "album",
      "kind": "image",
      "path": "/photo",
      "anchor": { "selector": ".photoAlbum", "insert": "beforeend" },
      "button": {
        "size": "medium",
        "showText": true,
        "label": "Download",
        "shape": "rounded",
        "colors": {
          "background": "#ff9000",
          "text": "#ffffff",
          "icon": "#ffffff",
          "border": "#ff9000",
          "hoverBackground": "#ffa31a"
        }
      }
    },
    {
      "id": "gifs",
      "kind": "gif",
      "path": "/gif",
      "anchor": { "selector": ".gifVideoBlock", "insert": "beforeend" },
      "button": {
        "size": "small",
        "showText": false,
        "label": "Download",
        "shape": "rounded",
        "colors": {
          "background": "#ff9000",
          "text": "#ffffff",
          "icon": "#ffffff",
          "border": "#ff9000",
          "hoverBackground": "#ffa31a"
        }
      }
    },
    {
      "id": "photo",
      "kind": "image",
      "path": "/photo",
      "anchor": { "selector": "#ratingSpace > li.omega", "insert": "afterend" },
      "button": {
        "size": "small",
        "showText": false,
        "label": "Download",
        "shape": "rounded",
        "colors": {
          "background": "#ff9000",
          "text": "#ffffff",
          "icon": "#ffffff",
          "border": "#ff9000",
          "hoverBackground": "#ffa31a"
        }
      }
    },
    {
      "id": "gif",
      "kind": "gif",
      "path": "/gif",
      "anchor": { "selector": "ul.votingWrap > li:has(#favoriteGifButton)", "insert": "afterend" },
      "button": {
        "size": "small",
        "showText": false,
        "label": "Download",
        "shape": "rounded",
        "colors": {
          "background": "#ff9000",
          "text": "#ffffff",
          "icon": "#ffffff",
          "border": "#ff9000",
          "hoverBackground": "#ffa31a"
        }
      }
    }
  ]
}
