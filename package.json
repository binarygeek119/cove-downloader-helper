{
  "name": "cove-downloader-helper",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Chrome extension that sends pages, links, and media to your Cove server.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -b && node scripts/build-extension.mjs",
    "pack": "npm run build && bash scripts/pack-extension.sh --force",
    "typecheck": "tsc -b",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:vulnerabilities": "node scripts/scan-vulnerabilities.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:vulnerabilities",
    "dev:ui": "vite --open /dev/index.html"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
